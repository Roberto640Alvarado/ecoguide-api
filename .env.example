# Database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoguide?retryWrites=true&w=majority"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP (Gmail, gratis) - Configuración → Google Account → Seguridad →
# Verificación en dos pasos → Contraseñas de aplicaciones. Genera una
# contraseña de aplicación de 16 caracteres para SMTP_PASS; nunca uses la
# contraseña normal de la cuenta, Google la rechaza para SMTP.
# A diferencia de proveedores como Resend en modo sandbox, Gmail SMTP no
# exige verificar un dominio propio para enviar a cualquier destinatario.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="EcoGuide <your-email@gmail.com>"
# Si un estudiante responde el correo, la respuesta llega a esta dirección
MAIL_REPLY_TO="your-email@gmail.com"

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=15

# AI Providers - clave usada para cifrar (AES-256-GCM) los apiKey antes de
# guardarlos en la base de datos. Genera una propia, p. ej. con:
# openssl rand -base64 32
AI_PROVIDER_ENCRYPTION_KEY="change-me-32-bytes-min"

# Node
NODE_ENV="development"
PORT=3000
