# Database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoguide?retryWrites=true&w=majority"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Brevo (API HTTP, SDK @getbrevo/brevo) - crea la cuenta gratis en
# https://www.brevo.com (sin tarjeta), luego SMTP & API → API Keys →
# Generate a new API key. MAIL_FROM debe verificarse como "sender" en
# Senders, Domains & Dedicated IPs → Senders → Add a sender: solo pide
# confirmar un código de 6 dígitos enviado a ese correo, no requiere
# verificar un dominio propio por DNS. Una vez verificado el sender, se
# puede enviar a cualquier destinatario sin restricciones.
BREVO_API_KEY="xkeysib-your-api-key"
MAIL_FROM="EcoGuide <your-verified-sender@example.com>"
# Si un estudiante responde el correo, la respuesta llega a esta dirección
MAIL_REPLY_TO="your-email@example.com"

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=15

# AI Providers - clave usada para cifrar (AES-256-GCM) los apiKey antes de
# guardarlos en la base de datos. Genera una propia, p. ej. con:
# openssl rand -base64 32
AI_PROVIDER_ENCRYPTION_KEY="change-me-32-bytes-min"

# Node
NODE_ENV="development"
PORT=3000
