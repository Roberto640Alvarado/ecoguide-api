# Database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoguide?retryWrites=true&w=majority"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gmail SMTP (nodemailer) - pasos para configurarlo:
# 1. Activa la Verificación en 2 pasos en la cuenta de Google que va a
#    enviar los correos (Google Account → Security → 2-Step Verification).
# 2. Genera una Contraseña de aplicación: en esa misma sección de
#    seguridad, busca "App passwords", créala (ej. nómbrala "API Backend")
#    y Google te da un código de 16 caracteres — esa es SMTP_PASSWORD, NO
#    la contraseña normal de la cuenta.
# 3. Completa SMTP_USER con el correo de Gmail y SMTP_PASSWORD con esos 16
#    caracteres (sin espacios). SMTP_HOST/SMTP_PORT ya traen el valor
#    correcto para Gmail por defecto, no hace falta tocarlos.
# ⚠️ Límite de Gmail: las cuentas gratuitas permiten hasta 500 correos por
# día — superar ese límite bloquea la cuenta temporalmente.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="ecoguidetraining@gmail.com"
SMTP_PASSWORD="dnqu thli jtfy iqzk"
MAIL_FROM="EcoGuide <ecoguidetraining@gmail.com>"
# Si un estudiante responde el correo, la respuesta llega a esta dirección
MAIL_REPLY_TO="your-email@example.com"

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=15

# AI Providers - clave usada para cifrar (AES-256-GCM) los apiKey antes de
# guardarlos en la base de datos. Genera una propia, p. ej. con:
# openssl rand -base64 32
AI_PROVIDER_ENCRYPTION_KEY="change-me-32-bytes-min"

# DeepL - traducción de contenido dinámico (lo que escribe el docente, o lo
# que genera la IA) al idioma seleccionado en el botón de idioma. Crea una
# cuenta gratis en https://www.deepl.com/pro-api (500,000 caracteres/mes),
# luego Account → copia tu "Authentication Key". Las keys del plan gratuito
# terminan en ":fx" — el servicio detecta el host correcto automáticamente.
DEEPL_API_KEY="your-deepl-api-key:fx"

# Node
NODE_ENV="development"
PORT=3000
