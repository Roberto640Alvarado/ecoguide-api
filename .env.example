# Database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoguide?retryWrites=true&w=majority"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRATION="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP (Brevo - https://app.brevo.com/settings/keys/smtp - 300 correos/día gratis)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-login@smtp-brevo.com"
SMTP_PASSWORD="your-brevo-smtp-key"
SMTP_FROM="your-verified-sender@example.com"

# Password Reset
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Node
NODE_ENV="development"
PORT=3000
